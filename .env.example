# Server-only configuration. Never expose these values through NEXT_PUBLIC_*.
LEGACY_CATALOG_URL=https://khkhkhkh.com/animecp/animeapi65/
LEGACY_ACCOUNT_URL=https://animecloudapp.com/aanimeApp65/
LEGACY_BACKUP_URL_TEMPLATE=https://animecloudapp.com/usersBackup/{userID}-{uniqID}.sqlite
LEGACY_PLAYBACK_PASSWORD=
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=./data/anime-cloud.sqlite
# Optional local desktop playback. MPV must run on the same machine as Next.js.
MPV_PATH=mpv
ANIME4K_SHADER_DIR=
# The legacy catalog currently needs this because its video host fails MPV's Windows TLS handshake.
MPV_TLS_VERIFY=no
